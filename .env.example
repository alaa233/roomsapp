# Optional TURN relay (comma-separated URLs). Needed for some NAT/firewall setups.
# Used at Vite build time for the browser bundle.
# VITE_TURN_URLS=turn:your.example.com:3478
# VITE_TURN_USERNAME=user
# VITE_TURN_CREDENTIAL=pass

# NestJS listens on PORT (Render sets this automatically).
# PORT=3000

# Mobile (Capacitor): default signaling server origin (https://…). Required for real
# devices unless MDM injects serverUrl via managed app config at runtime.
# VITE_SERVER_URL=https://your-service.onrender.com
